{
  "name": "@okta/jwt-verifier",
  "private": true,
  "version": "5.0.0",
  "description": "Easily validate Okta access tokens",
  "repository": "https://github.com/okta/okta-jwt-verifier-js",
  "homepage": "https://github.com/okta/okta-jwt-verifier-js",
  "main": "dist/cjs/index.cjs",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && rollup -c && tsc && node build-scripts/build.cjs",
    "test": "yarn test:unit && yarn test:integration && yarn lint",
    "test:integration": "../../scripts/tck.sh",
    "test:unit": "JEST_JUNIT_OUTPUT_FILE=./reports/unit/results.xml NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:ci": "JEST_JUNIT_OUTPUT_FILE=./reports/ci/results.xml NODE_OPTIONS=--experimental-vm-modules jest --testMatch '**/test/internal-ci/**/*.ts'",
    "lint": "eslint . --ext .js --ext .ts && tsc --noEmit"
  },
  "keywords": [
    "okta",
    "oidc",
    "OpenId Connect",
    "authentication",
    "auth",
    "jwt"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@okta/auth-foundation": "0.9.0"
  },
  "resolutions": {
    "minimist": "^1.2.6",
    "minimatch": "^3.1.2",
    "glob-parent": "^6.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.4.4",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.4",
    "cross-env": "^5.1.1",
    "dotenv": "^10.0.0",
    "eslint": "^8.34.0",
    "eslint-plugin-node": "^11.1.0",
    "express": "^4.18.2",
    "globby": "^11.0.4",
    "jest": "29.5.0",
    "jest-junit": "^13.0.0",
    "rollup": "^4.52.4",
    "rollup-plugin-cleanup": "^3.2.1",
    "shelljs": "^0.8.5",
    "ts-jest": "^29.4.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "undici": "^8.11.2"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "undici": ">=6"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  }
}
